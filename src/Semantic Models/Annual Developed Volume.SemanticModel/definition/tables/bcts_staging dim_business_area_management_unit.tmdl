table 'bcts_staging dim_business_area_management_unit'
	lineageTag: 0aa3e04e-5700-4027-98f4-8418a519cba0

	measure 'ADV Table Title' =
			
			VAR MU =
			    SELECTEDVALUE('bcts_staging dim_business_area_management_unit'[management_unit])
			
			VAR BA =
			    SELECTEDVALUE('bcts_staging dim_business_area_management_unit'[business_area_reporting_unit])
			
			VAR Region =
			    SELECTEDVALUE('bcts_staging dim_business_area_management_unit'[business_area_region])
			
			VAR RegionCategory =
			    SELECTEDVALUE('bcts_staging dim_business_area_management_unit'[business_area_region_category])
			
			RETURN
			"Annual Developed Volume (ADV): Actual ADV YTD  and Annual Target ADV - "
			&
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(MU), MU,
			    NOT ISBLANK(BA), BA,
			    NOT ISBLANK(Region), Region,
			    NOT ISBLANK(RegionCategory), RegionCategory,
			    "Province-wide"
			)
		lineageTag: 771f6ddd-c948-439e-9cf4-5bc6bb6a4767

